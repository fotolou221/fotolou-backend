# ===================================================================
# FOTOLOU BACKEND - VARIABLES D'ENVIRONNEMENT (.env)
# ===================================================================
# Ce fichier contient toutes les configurations de développement et production.
# En Dev, les valeurs par défaut ci-dessous fonctionnent immédiatement en local.
# En Prod, remplacez les valeurs secrètes (BDD, JWT, Twilio/Orange SMS).
# ===================================================================

# -------------------------------------------------------------------
# 🌐 1. CONFIGURATION DU SERVEUR & PROFIL SPRING BOOT
# -------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev,api-docs
SERVER_PORT=8080

# -------------------------------------------------------------------
# 🗄️ 2. BASE DE DONNÉES POSTGRESQL
# -------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fotolou_db
SPRING_DATASOURCE_USERNAME=fotolou_user
SPRING_DATASOURCE_PASSWORD=fotolou_secure_password

# -------------------------------------------------------------------
# 🔐 3. SÉCURITÉ & JETONS JWT (JSON Web Tokens)
# -------------------------------------------------------------------
# Clé secrète Base64 (au moins 256 bits / 32 octets)
# En Prod, générez une clé aléatoire forte
JWT_SECRET=YjhhZjkyNGU5MGM5NTFiMzQ1MTNkNWJhYzExMWRjOGE1Yzg4ZTE1NGRjNTY5ZjkyMjg0ZjUzNGNiMzI3MGY4ODlhNDdlMzgxYTk4MmViMGViMGVhYWRiYjA3MDdmMjU1MTcxN2Q5NTFhMGMyOGYwYzFjNWU4MzE2YmQwZTk4YTY=
JWT_TOKEN_VALIDITY_IN_SECONDS=86400
JWT_REMEMBER_ME_VALIDITY_IN_SECONDS=2592000

# -------------------------------------------------------------------
# 📱 4. SERVICES SMS & OTP (EXPÉDITION DES CODES PAR SMS)
# -------------------------------------------------------------------
# Choix du provider SMS : 'mock' (dev local), 'orange' (Orange SN), 'twilio'
SMS_PROVIDER=mock
SMS_SENDER_NAME=Fotolou

# Configuration Orange SMS API (si SMS_PROVIDER=orange)
# Obtenez vos clés sur : https://developer.orange.com
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=

# Configuration Twilio SMS (si SMS_PROVIDER=twilio)
# Obtenez vos clés sur : https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Paramètres des codes OTP
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=45

# -------------------------------------------------------------------
# ☁️ 5. STOCKAGE DES FICHIERS & IMAGES (Cloudinary / Local)
# -------------------------------------------------------------------
# Provider de stockage : 'cloudinary' (recommandé) ou 'local'
STORAGE_PROVIDER=cloudinary
STORAGE_UPLOAD_DIR=uploads
STORAGE_CDN_URL=/api/files/

# Identifiants Cloudinary (depuis https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Ou URL complète :
CLOUDINARY_URL=

# -------------------------------------------------------------------
# 🛍️ 6. PARAMÈTRES BOUTIQUE & COMMERCE (WhatsApp / Livraison)
# -------------------------------------------------------------------
BUSINESS_WHATSAPP_NUMBER=221778627052
BUSINESS_DELIVERY_FEE=2000

# -------------------------------------------------------------------
# ⚡ 7. REDIS CACHE (Recommandé en Production)
# -------------------------------------------------------------------
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# -------------------------------------------------------------------
# 🔒 8. CORS (Origines frontend autorisées)
# -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
