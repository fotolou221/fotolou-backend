# ===================================================================
# FOTOLOU BACKEND - MODÈLE DE VARIABLES D'ENVIRONNEMENT (.env.example)
# ===================================================================
# Copiez ce fichier vers .env : cp .env.example .env
# ===================================================================

# 🌐 SERVEUR & PROFIL
SPRING_PROFILES_ACTIVE=dev,api-docs
SERVER_PORT=8080

# 🗄️ BASE DE DONNÉES POSTGRESQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fotolou_db
SPRING_DATASOURCE_USERNAME=fotolou_user
SPRING_DATASOURCE_PASSWORD=votre_mot_de_passe_ici

# 🔐 SÉCURITÉ & JWT
JWT_SECRET=generer_une_cle_secrete_base64_tres_longue_ici_au_moins_256_bits
JWT_TOKEN_VALIDITY_IN_SECONDS=86400

# 📱 SMS & OTP (Choix : 'mock', 'orange', ou 'twilio')
SMS_PROVIDER=mock
SMS_SENDER_NAME=Fotolou
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 📂 STOCKAGE
STORAGE_PROVIDER=local
STORAGE_UPLOAD_DIR=uploads
STORAGE_CDN_URL=/api/files/

# 🛍️ E-COMMERCE & WHATSAPP
BUSINESS_WHATSAPP_NUMBER=221778627052
BUSINESS_DELIVERY_FEE=2000

# ⚡ REDIS (Optionnel)
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
